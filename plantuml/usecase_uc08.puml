@startuml usecase_uc08

skinparam linetype curve
skinparam defaultFontSize 12
skinparam backgroundColor #f4f6fb
skinparam usecase {
    BackgroundColor #ffffff
    BorderColor #5b6279
    FontColor #1e1e2e
    ArrowColor #5b6279
}
skinparam actor {
    BackgroundColor #dce3f5
    BorderColor #1a3a7a
    FontColor #1e1e2e
}
skinparam rectangle {
    BackgroundColor #f0f4fd
    BorderColor #4a6fa5
    FontColor #1a3a7a
    FontStyle bold
    RoundCorner 10
}
skinparam arrow {
    Color #5b6279
    FontColor #3b4261
    FontSize 10
}

left to right direction

actor "Người dùng" as user

rectangle "UC-08: Quản lý thành viên Card" {
    usecase "UC-08.1\nGán thành viên\nvào Card" as UC081
    usecase "UC-08.2\nHủy gán thành viên\nkhỏi Card" as UC082
}

user --> UC081
user --> UC082

UC082 ..> UC081 : <<extend>>

@enduml
