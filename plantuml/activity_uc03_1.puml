@startuml activity_uc03_1

skinparam linetype ortho
skinparam defaultFontSize 13
skinparam backgroundColor #f4f6fb
skinparam activity {
    BackgroundColor #ffffff
    BorderColor #5b6279
    FontColor #1e1e2e
    ArrowColor #4a6fa5
    DiamondBackgroundColor #dce3f5
    DiamondBorderColor #1a3a7a
    DiamondFontColor #1e1e2e
    StartColor #1a3a7a
    EndColor #1a3a7a
}

title UC-03.1: Tạo Workspace

start

:Người dùng đã đăng nhập vào hệ thống;
:Nhấn nút "Tạo Workspace mới";
:Mở form tạo Workspace;
:Nhập tên, chọn danh mục (WorkspaceCategory),\nnhập mô tả (tùy chọn);

if (Dữ liệu nhập hợp lệ?) then (Không)
    :Hiển thị thông báo lỗi validation;
    stop
else (Có)
    :Hệ thống gửi yêu cầu tạo Workspace;
    :Backend tạo Workspace;
    :Gán người tạo là ADMIN của Workspace;
    :Chuyển hướng đến trang Workspace vừa tạo;
endif

stop

@enduml
