@startuml activity_uc04_2

skinparam linetype ortho
skinparam defaultFontSize 13
skinparam backgroundColor #f4f6fb
skinparam activity {
    BackgroundColor #ffffff
    BorderColor #5b6279
    FontColor #1e1e2e
    ArrowColor #4a6fa5
    DiamondBackgroundColor #dce3f5
    DiamondBorderColor #1a3a7a
    DiamondFontColor #1e1e2e
    StartColor #1a3a7a
    EndColor #1a3a7a
}

title UC-04.2: Xem chi tiết Board

start

:Người dùng chọn một Board từ trang Workspace;
:Gửi yêu cầu GET /api/v1/boards/:id\n(lấy Board kèm List và Card);

if (Board tồn tại và user có quyền truy cập?) then (Không)
    :Trả về lỗi 403 Forbidden hoặc 404 Not Found;
    stop
else (Có)
    :Backend trả về dữ liệu Board\n(tên, ảnh nền, danh sách List, Card);
    :Hiển thị Board theo dạng Kanban;
endif

stop

@enduml
