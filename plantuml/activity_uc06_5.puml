@startuml activity_uc06_5

skinparam linetype ortho
skinparam defaultFontSize 13
skinparam backgroundColor #f4f6fb
skinparam activity {
    BackgroundColor #ffffff
    BorderColor #5b6279
    FontColor #1e1e2e
    ArrowColor #4a6fa5
    DiamondBackgroundColor #dce3f5
    DiamondBorderColor #1a3a7a
    DiamondFontColor #1e1e2e
    StartColor #1a3a7a
    EndColor #1a3a7a
}

title UC-06.5: Di chuyển Card giữa các List

start

:Người dùng đang xem Board (Kanban View);
:Kéo thả Card sang List khác hoặc vị trí mới;
:Frontend tính toán listId đích và position mới;
:Cập nhật giao diện tức thì (optimistic update);
:Gửi yêu cầu PATCH /api/v1/cards/:id\n(cập nhật listId và position);

if (Di chuyển thành công?) then (Không)
    :Rollback giao diện về vị trí cũ;
    :Hiển thị thông báo lỗi;
else (Có)
    :Giữ nguyên vị trí mới trên giao diện;
endif

stop

@enduml
