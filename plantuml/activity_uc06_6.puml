@startuml activity_uc06_6

skinparam linetype ortho
skinparam defaultFontSize 13
skinparam backgroundColor #f4f6fb
skinparam activity {
    BackgroundColor #ffffff
    BorderColor #5b6279
    FontColor #1e1e2e
    ArrowColor #4a6fa5
    DiamondBackgroundColor #dce3f5
    DiamondBorderColor #1a3a7a
    DiamondFontColor #1e1e2e
    StartColor #1a3a7a
    EndColor #1a3a7a
}

title UC-06.6: Xóa Card

start

:Người dùng mở Card Detail Modal hoặc menu Card;
:Chọn tùy chọn "Xóa Card";
:Hiển thị hộp thoại xác nhận xóa Card;

if (Người dùng xác nhận xóa?) then (Có)
    :Hệ thống gửi yêu cầu xóa Card;
    :Backend xóa Card (cascade: Checklist, ChecklistItem, CardMember);
    :Xóa Card khỏi giao diện Kanban;
else (Không)
    :Hủy thao tác;
endif

stop

@enduml
