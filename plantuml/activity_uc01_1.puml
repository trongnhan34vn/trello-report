@startuml activity_uc01_1

skinparam linetype ortho
skinparam defaultFontSize 13
skinparam backgroundColor #f4f6fb
skinparam activity {
    BackgroundColor #ffffff
    BorderColor #5b6279
    FontColor #1e1e2e
    ArrowColor #4a6fa5
    DiamondBackgroundColor #dce3f5
    DiamondBorderColor #1a3a7a
    DiamondFontColor #1e1e2e
    StartColor #1a3a7a
    EndColor #1a3a7a
}

title UC-01.1: Đăng ký tài khoản

start

:Người dùng chưa có tài khoản;
:Truy cập trang Đăng ký;
:Nhập thông tin đăng ký\n(fullName, email, password);
:Hệ thống tiếp nhận và xử lý yêu cầu đăng ký;

if (Thông tin hợp lệ?) then (Không)
    :Hiển thị thông báo lỗi validation;
    stop
else (Có)
    :AWS Cognito tạo tài khoản tạm thời;
    :Cognito gửi mã OTP qua email;
    :Chuyển hướng đến trang xác nhận OTP;
endif

stop

@enduml
