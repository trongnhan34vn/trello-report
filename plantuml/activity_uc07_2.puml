@startuml activity_uc07_2

skinparam linetype ortho
skinparam defaultFontSize 13
skinparam backgroundColor #f4f6fb
skinparam activity {
    BackgroundColor #ffffff
    BorderColor #5b6279
    FontColor #1e1e2e
    ArrowColor #4a6fa5
    DiamondBackgroundColor #dce3f5
    DiamondBorderColor #1a3a7a
    DiamondFontColor #1e1e2e
    StartColor #1a3a7a
    EndColor #1a3a7a
}

title UC-07.2: Cập nhật Checklist

start

:Người dùng mở Card Detail Modal;
:Nhấn vào tên Checklist để chỉnh sửa;
:Nhập tên mới cho Checklist;

if (Tên hợp lệ?) then (Không)
    :Hiển thị thông báo lỗi;
    stop
else (Có)
    :Hệ thống gửi yêu cầu cập nhật thông tin Checklist;
    :Backend lưu thông tin Checklist;
    :Cập nhật tên Checklist trên giao diện;
endif

stop

@enduml
