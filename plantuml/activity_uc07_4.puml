@startuml activity_uc07_4

skinparam linetype ortho
skinparam defaultFontSize 13
skinparam backgroundColor #f4f6fb
skinparam activity {
    BackgroundColor #ffffff
    BorderColor #5b6279
    FontColor #1e1e2e
    ArrowColor #4a6fa5
    DiamondBackgroundColor #dce3f5
    DiamondBorderColor #1a3a7a
    DiamondFontColor #1e1e2e
    StartColor #1a3a7a
    EndColor #1a3a7a
}

title UC-07.4: Tạo Checklist Item

start

:Người dùng mở Card Detail Modal;
:Chọn một Checklist muốn thêm Item;
:Nhấn nút "Thêm Item";
:Nhập tên Checklist Item;

if (Tên hợp lệ?) then (Không)
    :Hiển thị thông báo lỗi;
    stop
else (Có)
    :Hệ thống gửi yêu cầu tạo Checklist Item mới;
    :Backend lưu Item trong Checklist;
    :Hiển thị Item mới trong Checklist;
endif

stop

@enduml
