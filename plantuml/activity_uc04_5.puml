@startuml activity_uc04_5

skinparam linetype ortho
skinparam defaultFontSize 13
skinparam backgroundColor #f4f6fb
skinparam activity {
    BackgroundColor #ffffff
    BorderColor #5b6279
    FontColor #1e1e2e
    ArrowColor #4a6fa5
    DiamondBackgroundColor #dce3f5
    DiamondBorderColor #1a3a7a
    DiamondFontColor #1e1e2e
    StartColor #1a3a7a
    EndColor #1a3a7a
}

title UC-04.5: Thêm thành viên vào Board

start

:Người dùng truy cập trang Board;
:Mở chức năng quản lý thành viên Board;
:Hệ thống gửi yêu cầu lấy danh sách thành viên Workspace;
:Hiển thị danh sách thành viên Workspace;
:Chọn thành viên từ danh sách;
:Hệ thống gửi yêu cầu thêm thành viên vào Board;

if (Thêm thành viên thành công?) then (Không)
    :Hiển thị thông báo lỗi;
    stop
else (Có)
    :Thêm thành viên vào Board với role mặc định MEMBER;
    :Hiển thị thông báo thêm thành viên thành công;
endif

stop

@enduml
