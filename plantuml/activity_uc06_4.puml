@startuml activity_uc06_4

skinparam linetype ortho
skinparam defaultFontSize 13
skinparam backgroundColor #f4f6fb
skinparam activity {
    BackgroundColor #ffffff
    BorderColor #5b6279
    FontColor #1e1e2e
    ArrowColor #4a6fa5
    DiamondBackgroundColor #dce3f5
    DiamondBorderColor #1a3a7a
    DiamondFontColor #1e1e2e
    StartColor #1a3a7a
    EndColor #1a3a7a
}

title UC-06.4: Đánh dấu Card hoàn thành

start

:Người dùng mở Card Detail Modal;
:Nhấn nút "Đánh dấu hoàn thành";
:Hệ thống gửi yêu cầu cập nhật trạng thái hoàn thành Card;

if (Cập nhật thành công?) then (Không)
    :Hiển thị thông báo lỗi;
    stop
else (Có)
    :Backend cập nhật trạng thái hoàn thành;
    :Hiển thị Card với trạng thái "Hoàn thành";
endif

stop

@enduml
