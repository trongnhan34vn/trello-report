@startuml activity_uc04_4

skinparam linetype ortho
skinparam defaultFontSize 13
skinparam backgroundColor #f4f6fb
skinparam activity {
    BackgroundColor #ffffff
    BorderColor #5b6279
    FontColor #1e1e2e
    ArrowColor #4a6fa5
    DiamondBackgroundColor #dce3f5
    DiamondBorderColor #1a3a7a
    DiamondFontColor #1e1e2e
    StartColor #1a3a7a
    EndColor #1a3a7a
}

title UC-04.4: Xóa Board

start

:Người dùng đang xem Board;
:Chọn tùy chọn "Xóa Board";
:Hiển thị hộp thoại xác nhận xóa Board;

if (Người dùng xác nhận xóa?) then (Có)
    :Hệ thống gửi yêu cầu xóa Board;
    :Backend xóa Board (cascade: List, Card, CheckList);
    :Chuyển hướng về trang Workspace;
else (Không)
    :Hủy thao tác, đóng hộp thoại;
endif

stop

@enduml
