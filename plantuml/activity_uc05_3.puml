@startuml activity_uc05_3

skinparam linetype ortho
skinparam defaultFontSize 13
skinparam backgroundColor #f4f6fb
skinparam activity {
    BackgroundColor #ffffff
    BorderColor #5b6279
    FontColor #1e1e2e
    ArrowColor #4a6fa5
    DiamondBackgroundColor #dce3f5
    DiamondBorderColor #1a3a7a
    DiamondFontColor #1e1e2e
    StartColor #1a3a7a
    EndColor #1a3a7a
}

title UC-05.3: Xóa List

start

:Người dùng đang xem Board (Kanban View);
:Chọn tùy chọn "Xóa List";
:Hiển thị hộp thoại xác nhận xóa List;

if (Người dùng xác nhận xóa?) then (Có)
    :Gửi yêu cầu DELETE /api/v1/lists/:id;
    :Backend xóa List (cascade: Card, Checklist, ChecklistItem);
    :Xóa cột List khỏi giao diện Kanban;
else (Không)
    :Hủy thao tác;
endif

stop

@enduml
