@startuml activity_uc02_1

skinparam linetype ortho
skinparam defaultFontSize 13
skinparam backgroundColor #f4f6fb
skinparam activity {
    BackgroundColor #ffffff
    BorderColor #5b6279
    FontColor #1e1e2e
    ArrowColor #4a6fa5
    DiamondBackgroundColor #dce3f5
    DiamondBorderColor #1a3a7a
    DiamondFontColor #1e1e2e
    StartColor #1a3a7a
    EndColor #1a3a7a
}

title UC-02.1: Xem thông tin cá nhân

start

:Người dùng đã đăng nhập vào hệ thống;
:Truy cập trang thông tin cá nhân;
:Hệ thống gửi yêu cầu tải thông tin cá nhân\n(kèm access_token trong cookie);

if (Token hợp lệ?) then (Không)
    :Trả về lỗi 401 Unauthorized;
    stop
else (Có)
    :Backend trả về thông tin người dùng\n(fullName, email, avatar, bio, phone, address);
    :Hiển thị trang thông tin cá nhân;
endif

stop

@enduml
