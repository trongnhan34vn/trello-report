@startuml activity_uc03_4

skinparam linetype ortho
skinparam defaultFontSize 13
skinparam backgroundColor #f4f6fb
skinparam activity {
    BackgroundColor #ffffff
    BorderColor #5b6279
    FontColor #1e1e2e
    ArrowColor #4a6fa5
    DiamondBackgroundColor #dce3f5
    DiamondBorderColor #1a3a7a
    DiamondFontColor #1e1e2e
    StartColor #1a3a7a
    EndColor #1a3a7a
}

title UC-03.4: Mời thành viên vào Workspace

start

:Người dùng truy cập trang Workspace;
:Mở chức năng quản lý thành viên;
:Nhập email người dùng cần mời;
:Hệ thống gửi yêu cầu thêm thành viên theo email;

if (Email tồn tại trong hệ thống?) then (Không)
    :Hiển thị thông báo không tìm thấy người dùng;
    stop
else (Có)
    :Thêm thành viên vào Workspace với role MEMBER;
    :Cập nhật danh sách thành viên;
    :Hiển thị thông báo mời thành công;
endif

stop

@enduml
