@startuml activity_uc06_2

skinparam linetype ortho
skinparam defaultFontSize 13
skinparam backgroundColor #f4f6fb
skinparam activity {
    BackgroundColor #ffffff
    BorderColor #5b6279
    FontColor #1e1e2e
    ArrowColor #4a6fa5
    DiamondBackgroundColor #dce3f5
    DiamondBorderColor #1a3a7a
    DiamondFontColor #1e1e2e
    StartColor #1a3a7a
    EndColor #1a3a7a
}

title UC-06.2: Xem chi tiết Card

start

:Người dùng nhấn vào một Card trong Kanban;
:Gửi yêu cầu GET /api/v1/cards/:id;

if (Card tồn tại và user có quyền truy cập?) then (Không)
    :Trả về lỗi 403 Forbidden hoặc 404 Not Found;
    stop
else (Có)
    :Backend trả về chi tiết Card\n(title, description, dueDate, checklist, members);
    :Hiển thị Card Detail Modal;
endif

stop

@enduml
