@startuml activity_uc01_3

skinparam linetype ortho
skinparam defaultFontSize 13
skinparam backgroundColor #f4f6fb
skinparam activity {
    BackgroundColor #ffffff
    BorderColor #5b6279
    FontColor #1e1e2e
    ArrowColor #4a6fa5
    DiamondBackgroundColor #dce3f5
    DiamondBorderColor #1a3a7a
    DiamondFontColor #1e1e2e
    StartColor #1a3a7a
    EndColor #1a3a7a
}

title UC-01.3: Gửi lại mã OTP

start

:Người dùng đang ở trang xác nhận OTP;
:Nhấn nút "Gửi lại mã OTP";
:Gửi yêu cầu POST /api/v1/auth/resend-code\n(kèm email);

if (Yêu cầu hợp lệ?) then (Không)
    :Hiển thị thông báo lỗi;
    stop
else (Có)
    :Cognito gửi lại mã OTP mới qua email;
    :Hiển thị thông báo gửi lại thành công;
    :Người dùng kiểm tra email và nhập OTP mới;
endif

stop

@enduml
